load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "antfly",
    srcs = ["provider.go"],
    importpath = "github.com/gastownhall/gascity/internal/storebinding/antfly",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/beads",
        "//internal/coordclass",
        "//internal/storebinding",
        "//internal/storebinding/beadsworkspace",
        "@com_github_steveyegge_beads//backend/antfly",
    ],
)

go_test(
    name = "antfly_test",
    srcs = ["provider_test.go"],
    embed = [":antfly"],
    deps = [
        "//internal/beads",
        "//internal/coordclass",
        "//internal/nudgequeue",
        "//internal/storebinding",
        "@com_github_steveyegge_beads//backend/antfly",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
